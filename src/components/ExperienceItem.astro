---
import LinkInline from "./LinkInline.astro";

interface Props {
  title: string;
  company: string;
  description: string;
  link?: string;
  date: string;
  datetime?: string;
}

const { title, company, description, link, date, datetime } = Astro.props;
---

<div
  class="relative ml-8 grid pb-12 before:absolute before:left-[-23px] before:block before:h-full before:w-px before:bg-gray-200 before:content-[''] dark:before:bg-white/10 md:ml-12 md:grid-cols-5 md:gap-10 md:space-x-4 md:before:left-[-35px]"
>
  <div class="relative pb-4 md:pb-12 md:col-span-2">
    <div class="sticky top-0">
      <span
        class="absolute -left-[30px] top-1 size-3 rounded-full border-2 border-blue-700 bg-gray-50 dark:border-blue-300 dark:bg-gray-950 md:-left-[42px]"
        aria-hidden="true"
      ></span>

      <h3 class="text-xl font-bold tracking-tight text-gray-950 dark:text-white">{title}</h3>
      <h4 class="mt-1 font-medium text-blue-700 dark:text-blue-300">
        {company}
      </h4>
      <time
        class="mt-2 block p-0 text-xs font-semibold tracking-wide uppercase text-gray-500 dark:text-gray-500"
        datetime={datetime}>{date}</time>
    </div>
  </div>
  <div
    class="relative flex flex-col gap-3 pb-4 text-gray-700 dark:text-gray-300 md:col-span-3 leading-relaxed"
  >
    {description}
    {
      link && (
        <LinkInline href={link}>
          Company website{" "}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-5 icon icon-tabler icon-tabler-chevron-right"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
            <path d="M9 6l6 6l-6 6" />
          </svg>
        </LinkInline>
      )
    }
  </div>
</div>
