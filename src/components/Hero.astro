---
import Badge from "@/components/Badge.astro";
import LinkedInIcon from "@/components/icons/LinkedIn.astro";
import MailIcon from "@/components/icons/Mail.astro";
import SocialPill from "@/components/SocialPill.astro";
import MediumIcon from "@/components/icons/Medium.astro";
import YoutubeIcon from "@/components/icons/Youtube.astro";
---

<div class="max-w-xl">
  <h1
    class="text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white"
  >
    Hi, I'm Isai Colina
  </h1>
  <p
    class="mt-6 text-xl text-gray-800 dark:[&>strong]:text-cyan-200 [&>strong]:text-cyan-800 [&>strong]:font-semibold dark:text-gray-300"
  >
    Agentic AI Chapter Lead and Full Stack Engineering leader with over <strong
      >7 years of experience</strong
    > building scalable products, leading cross-functional teams, and turning
    technical decisions into measurable business outcomes.
  </p>

  <nav class="flex flex-wrap gap-4 mt-8">
    <SocialPill href="mailto:isaicolinapinto@gmail.com">
      <MailIcon class="size-4" />
      Contact
    </SocialPill>
    <SocialPill href="https://www.linkedin.com/in/isai-colina-pinto-57123b155/">
      <LinkedInIcon class="size-4" />
      LinkedIn
    </SocialPill>
    <SocialPill href="https://medium.com/@isaicolinapinto_70265">
      <MediumIcon class="size-4" />
      Medium
    </SocialPill>
    <SocialPill href="https://www.youtube.com/channel/UCT8C9RwEz_Ij7dYfvfbhCrw">
      <YoutubeIcon class="size-4" />
      Youtube
    </SocialPill>
  </nav>
  <div class="flex flex-wrap mt-8">
    <Badge>Technical Leadership</Badge>
    <Badge>Agentic AI Systems</Badge>
    <Badge>Multi-Agent Architecture</Badge>
    <Badge>AI Delivery Strategy</Badge>
    <Badge>Product-Oriented Engineering</Badge>
    <Badge>Full Stack Systems</Badge>
    <Badge>AWS / GCP</Badge>
  </div>
</div>
