---
import GitHub from "./icons/GitHub.astro";
import Link from "./icons/Link.astro";
import LinkButton from "./LinkButton.astro";
import alexandraImg from "../assets/projects/alexandra.webp";
import damacomImg from "../assets/projects/damacom.webp";
import ulpanImg from "../assets/projects/ulpan.webp";
import catsImg from "../assets/projects/cats.webp";
import comparteImg from "../assets/projects/comparte.webp";
import spotifyImg from "../assets/projects/spotify.webp";

const PROJECTS = [
  {
    title: "Damacom Tracking System",
    description:
      "End-to-end delivery of the web platform used to track the panela production lifecycle. I led frontend architecture with React, Vite, TypeScript, and SASS, focusing on maintainability, performance, and clear operator workflows.",
    link: "https://damacom.deno.dev/",
    image: damacomImg.src,
  },
  {
    title: "Alexandra Villarroel",
    description:
      "Website implementation for an internationally recognized coach, balancing visual storytelling and performance. I executed the full experience using GSAP, Bootstrap, JavaScript, PHP, and MySQL, translating complex design into a polished production site.",
    link: "https://alexandravillarroel.com/",
    image: alexandraImg.src,
  },
  {
    title: "Ulpan Yovel",
    description:
      "Development of an educational platform where courses and teachers are managed from a centralized workflow. I built and customized the WordPress-based solution to support content operations and long-term maintainability.",
    link: "https://ulpanyovel.com/ulpan/",
    image: ulpanImg.src,
  },
  {
    title: "Dressed in Blue",
    description:
      "Design and development of a business website with strong SEO orientation for the Colombian market. I delivered a performant implementation with JavaScript, HTML, and SASS to support brand positioning and organic visibility.",
    link: "https://dressedinblue.com.co/",
    image: catsImg.src,
  },
  {
    title: "Comp@rt",
    description:
      "Built a full stack content-sharing application inspired by Pinterest. I implemented the frontend with Next.js and Tailwind, and connected Sanity CMS through GraphQL for scalable content management.",
    link: "https://compart.netlify.app/",
    github: "https://github.com/oskr1103/front-compart",
    image: comparteImg.src,
  },
  {
    title: "Clone Spotify",
    description:
      "Built a Spotify-inspired product as an onboarding project, integrating external APIs and state-driven UI flows. Developed with React, TypeScript, Redux, and SASS under clean code and modular architecture practices. Note: access requires authorization because it is in development mode.",
    link: "https://isai-music-clone.netlify.app/",
    github: "https://github.com/oskr1103/music-app",
    image: spotifyImg.src,
  },
];
---

<div class="flex flex-col gap-y-16">
  {
    PROJECTS.map(({ image, title, description, link, github }) => (
      <article class="flex flex-col space-x-0 space-y-8 group md:flex-row md:space-x-8 md:space-y-0">
        <div class="w-full md:w-1/2">
          <div class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-2xl lg:border lg:border-gray-800 lg:hover:border-gray-700 lg:hover:bg-gray-800/50">
            <img
              alt="Works Isai Colina"
              class="object-cover object-top w-full h-56 transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-105"
              src={image}
            />
          </div>
        </div>

        <div class="w-full md:w-1/2 md:max-w-lg">
          <h3 class="text-2xl font-bold text-gray-800 dark:text-gray-100">
            {title}
          </h3>
          <div class="flex flex-wrap mt-2">
            <div class="mt-2 text-gray-700 dark:text-gray-400">
              {description}
            </div>
            <footer class="flex items-end justify-start mt-4 gap-x-4">
              {github && (
                <LinkButton href={github}>
                  <GitHub class="size-6" />
                  Code
                </LinkButton>
              )}
              {link && (
                <LinkButton href={link}>
                  <Link class="size-4" />
                  Preview
                </LinkButton>
              )}
            </footer>
          </div>
        </div>
      </article>
    ))
  }
</div>
