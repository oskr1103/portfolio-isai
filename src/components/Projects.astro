---
import Link from "./icons/Link.astro";
import LinkButton from "./LinkButton.astro";
import { Image } from "astro:assets";
import alexandraImg from "../assets/projects/alexandra.webp";
import damacomImg from "../assets/projects/damacom.webp";
import catsImg from "../assets/projects/cats.webp";

const AI_WORK = [
  {
    title: "Enterprise AI & Agent Platform",
    focus: "Architecture · Delivery · Governance",
    summary:
      "Architecture and delivery of an enterprise AI capability integrating identity, memory, reasoning, retrieval, internal tools, and proactive events across multiple communication channels.",
    details: [
      "Designed reusable agent capabilities for enterprise workflows.",
      "Defined ownership, delivery standards, and production operating models.",
      "Connected identity, memory, retrieval, tools, and multi-channel interfaces.",
    ],
    flow: ["Identity", "Context & memory", "Reasoning", "Tools & events"],
  },
  {
    title: "AI Support System",
    focus: "Production Agents · Tool Use · Escalation",
    summary:
      "Production-oriented agentic support system designed to resolve internal requests, invoke business tools, retrieve organizational knowledge, and escalate cases with context when human intervention is required.",
    details: [
      "Built agent flows for request resolution and knowledge retrieval.",
      "Integrated business tools with clear escalation boundaries.",
      "Preserved human oversight for ambiguous or high-risk cases.",
    ],
    flow: ["Request", "Knowledge & tools", "Resolution", "Human escalation"],
  },
  {
    title: "Agentic Decision System",
    focus: "Multi-Agent · Analysis · Human Gates",
    summary:
      "Multi-agent architecture for complex business analysis, combining specialized evaluation agents, structured case files, critical review, and human-gated decision memos.",
    details: [
      "Coordinated specialized agents for evaluation and critical review.",
      "Structured case files to support traceable decisions.",
      "Required human approval before high-impact recommendations.",
    ],
    flow: ["Case file", "Specialist agents", "Critical review", "Decision memo"],
  },
  {
    title: "Autonomous Engineering Workflows",
    focus: "AI Delivery · Review · Ownership",
    summary:
      "AI-assisted software delivery workflows designed to reduce implementation time while maintaining technical review, observability, security boundaries, and engineering ownership.",
    details: [
      "Accelerated implementation without removing engineering accountability.",
      "Kept review, observability, and security boundaries in the loop.",
      "Treated AI as an execution amplifier, not a substitute for ownership.",
    ],
    flow: ["Intent", "AI execution", "Technical review", "Observable delivery"],
  },
];

const PREVIOUS_PROJECTS = [
  {
    title: "Damacom Tracking System",
    description:
      "End-to-end delivery of the web platform used to track the panela production lifecycle. I led frontend architecture with React, Vite, TypeScript, and SASS.",
    link: "https://damacom.deno.dev/",
    image: damacomImg,
    alt: "Damacom tracking system interface for panela production",
  },
  {
    title: "Alexandra Villarroel",
    description:
      "Website implementation for an internationally recognized coach, balancing visual storytelling and performance with GSAP, Bootstrap, JavaScript, PHP, and MySQL.",
    link: "https://alexandravillarroel.com/",
    image: alexandraImg,
    alt: "Alexandra Villarroel coaching website homepage",
  },
  {
    title: "Dressed in Blue",
    description:
      "Business website with strong SEO orientation for the Colombian market, delivered with JavaScript, HTML, and SASS to support brand positioning and organic visibility.",
    link: "https://dressedinblue.com.co/",
    image: catsImg,
    alt: "Dressed in Blue business website preview",
  },
];
---

<div class="grid gap-5 lg:grid-cols-2">
  {
    AI_WORK.map(({ title, focus, summary, details, flow }, index) => (
      <article
        class:list={[
          "group relative overflow-hidden border border-gray-200/90 bg-white/50 p-6 dark:border-white/10 dark:bg-white/[0.025] md:p-8",
          index === 0 || index === 3 ? "lg:col-span-2" : "",
          "rounded-xl",
        ]}
      >
        <div class:list={["grid gap-8", index === 0 || index === 3 ? "lg:grid-cols-[1.15fr_.85fr] lg:items-start" : ""]}>
          <div>
            <div class="flex items-center justify-between gap-4">
              <p class="text-xs font-semibold tracking-[0.15em] uppercase text-blue-700 dark:text-blue-300">
                {focus}
              </p>
              <span class="font-mono text-sm text-gray-400 dark:text-gray-600">0{index + 1}</span>
            </div>
            <h3 class="mt-4 max-w-xl text-2xl font-bold tracking-tight text-gray-950 dark:text-gray-100 md:text-3xl">
              {title}
            </h3>
            <p class="mt-4 max-w-2xl text-gray-700 dark:text-gray-300 leading-relaxed">
              {summary}
            </p>
          </div>

          <div class:list={["border-t border-gray-200 pt-6 dark:border-white/10", index === 0 || index === 3 ? "lg:border-l lg:border-t-0 lg:pl-8 lg:pt-0" : ""]}>
            <p class="text-xs font-semibold tracking-[0.16em] uppercase text-gray-500 dark:text-gray-400">
              Capability path
            </p>
            <ol class="mt-4 grid gap-2">
              {flow.map((step, stepIndex) => (
                <li class="flex items-center gap-3">
                  <span class="flex size-6 shrink-0 items-center justify-center rounded-sm bg-blue-100 font-mono text-[11px] font-semibold text-blue-900 dark:bg-blue-950 dark:text-blue-200">
                    {stepIndex + 1}
                  </span>
                  <span class="text-sm font-medium text-gray-700 dark:text-gray-300">{step}</span>
                  {stepIndex < flow.length - 1 && (
                    <span class="ml-auto text-gray-300 dark:text-gray-700" aria-hidden="true">↓</span>
                  )}
                </li>
              ))}
            </ol>
          </div>
        </div>

        <ul class="mt-7 grid gap-3 border-t border-gray-200 pt-6 text-sm text-gray-700 dark:border-white/10 dark:text-gray-400 md:grid-cols-3">
          {details.map((detail) => (
            <li class="flex gap-2 leading-relaxed">
              <span class="mt-2 size-1.5 shrink-0 rounded-full bg-blue-600 dark:bg-blue-300" aria-hidden="true"></span>
              {detail}
            </li>
          ))}
        </ul>
      </article>
    ))
  }
</div>

<section class="mt-20" aria-labelledby="previous-projects-heading">
  <h3
    id="previous-projects-heading"
    class="mb-8 text-xl font-semibold text-gray-800 dark:text-white"
  >
    Previous Product & Web Projects
  </h3>
  <div class="grid gap-5 md:grid-cols-3">
    {
      PREVIOUS_PROJECTS.map(({ image, title, description, link, alt }) => (
        <article class="group overflow-hidden rounded-xl border border-gray-200 bg-white/40 dark:border-white/10 dark:bg-white/[0.025]">
          <div class="overflow-hidden border-b border-gray-200 dark:border-white/10">
              <Image
                alt={alt}
                class="h-36 w-full object-cover object-top transition duration-500 group-hover:scale-[1.03]"
                src={image}
                widths={[480, 720, 960]}
                sizes="(max-width: 768px) 100vw, 320px"
                loading="lazy"
              />
          </div>

          <div class="p-5">
            <h4 class="text-lg font-bold text-gray-800 dark:text-gray-100">
              {title}
            </h4>
            <p class="mt-2 text-sm text-gray-700 dark:text-gray-400 leading-relaxed">
              {description}
            </p>
            <footer class="flex items-end justify-start mt-4 gap-x-4">
              {link && (
                <LinkButton href={link}>
                  <Link class="size-4" aria-hidden="true" />
                  Preview
                </LinkButton>
              )}
            </footer>
          </div>
        </article>
      ))
    }
  </div>
</section>
