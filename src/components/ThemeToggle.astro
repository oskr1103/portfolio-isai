---
import SunIcon from "./icons/Sun.astro";
import MoonIcon from "./icons/Moon.astro";
import SystemIcon from "./icons/System.astro";

const THEMES = ["Light", "Dark", "System"];
---

<div class="relative ml-1 mr-1">
  <button
    id="theme-toggle-btn"
    type="button"
    class="appearance-none border-none flex p-2 hover:scale-110 transition"
    aria-haspopup="true"
    aria-expanded="false"
    aria-controls="themes-menu"
  >
    <span class="sr-only">Change theme</span>
    <SunIcon id="light" class="theme-toggle-icon size-5 transition-all" aria-hidden="true" />
    <MoonIcon
      id="dark"
      class="theme-toggle-icon absolute size-5 transition-all"
      aria-hidden="true"
    />
    <SystemIcon
      id="system"
      class="theme-toggle-icon absolute size-5 transition-all"
      aria-hidden="true"
    />
  </button>
  <div
    id="themes-menu"
    role="menu"
    aria-label="Theme options"
    class="absolute hidden scale-80 top-8 right-0 text-sm p-1 min-w-[8rem] rounded-md border border-gray-100 bg-white/90 dark:bg-gray-900/90 dark:border-gray-500/20 backdrop-blur-md"
  >
    <ul class="list-none m-0 p-0">
      {
        THEMES.map((theme) => (
          <li role="none">
            <button
              type="button"
              role="menuitem"
              class="themes-menu-option w-full text-left px-2 py-1.5 cursor-pointer hover:bg-neutral-400/40 dark:hover:bg-gray-500/50 rounded-sm"
            >
              {theme}
            </button>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  #themes-menu.open {
    display: inline;
    animation: scale-up-center 0.15s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
  }

  @media (prefers-reduced-motion: reduce) {
    #themes-menu.open {
      animation: none;
    }
  }

  @keyframes scale-up-center {
    from {
      transform: scale(0.8);
      opacity: 0;
    }

    to {
      transform: scale(1);
      opacity: 1;
    }
  }
</style>

<script is:inline>
  let remove = null;
  const matchMedia = window.matchMedia("(prefers-color-scheme: dark)");
  const themesMenu = document.getElementById("themes-menu");
  const themeToggleBtn = document.getElementById("theme-toggle-btn");

  const getThemePreference = () => {
    if (typeof localStorage !== "undefined") {
      return localStorage.getItem("theme") ?? "system";
    }

    return window.matchMedia("(prefers-color-scheme: dark)").matches
      ? "dark"
      : "light";
  };

  const updateIcon = (themePreference) => {
    document.querySelectorAll(".theme-toggle-icon").forEach((element) => {
      element.style.scale = element.id === themePreference ? "1" : "0";
    });
  };

  const setMenuOpen = (open) => {
    themesMenu.classList.toggle("open", open);
    themeToggleBtn.setAttribute("aria-expanded", open ? "true" : "false");
  };

  const updateTheme = () => {
    if (remove != null) {
      remove();
    }
    matchMedia.addEventListener("change", updateTheme);
    remove = () => {
      matchMedia.removeEventListener("change", updateTheme);
    };

    const themePreference = getThemePreference();
    const isDark =
      themePreference === "dark" ||
      (themePreference === "system" && matchMedia.matches);

    updateIcon(themePreference);
    document.documentElement.classList[isDark ? "add" : "remove"]("dark");
  };

  updateTheme();

  document.addEventListener("click", () => setMenuOpen(false));

  themeToggleBtn.addEventListener("click", (e) => {
    e.stopPropagation();
    setMenuOpen(!themesMenu.classList.contains("open"));
  });

  document.querySelectorAll(".themes-menu-option").forEach((element) => {
    element.addEventListener("click", (e) => {
      localStorage.setItem("theme", e.target.innerText.toLowerCase().trim());
      updateTheme();
      setMenuOpen(false);
    });
  });
</script>
