---
import ThemeToggle from "./ThemeToggle.astro";
import { Image } from "astro:assets";
import imgRounded from "@/assets/isaiRounded.png";

const personalImageAlt = "Isai Colina, Engineering Lead";

const navItems = [
  {
    title: "Experience",
    label: "experience",
    url: "/#experience",
  },
  {
    title: "Work",
    label: "work",
    url: "/#work",
  },
  {
    title: "Education",
    label: "education",
    url: "/#education",
  },
  {
    title: "About",
    label: "about",
    url: "/#about",
  },
  {
    title: "Contact",
    label: "contact",
    url: "mailto:isaicolinapinto@gmail.com",
  },
];
---

<a
  href="#main-content"
  class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded-md focus:bg-white focus:px-4 focus:py-2 focus:text-black"
>
  Skip to content
</a>

<header
  class="section app__navbar relative mx-auto mt-4 flex w-[calc(100%-2rem)] max-w-5xl items-center justify-between"
>
  <a href="/" class="flex items-center gap-3" aria-label="Isai Colina, home">
    <Image
      class="size-10 rounded-full md:size-12"
      src={imgRounded}
      alt={personalImageAlt}
      width={48}
      height={48}
      widths={[40, 48, 96]}
      sizes="48px"
      loading="eager"
    />
    <span class="text-sm font-semibold text-gray-900 dark:text-white md:hidden">Isai Colina</span>
  </a>
  <nav
    id="primary-navigation"
    aria-label="Primary"
    class="hidden items-center justify-center rounded-full px-2 text-sm font-medium text-gray-700 dark:text-gray-200 md:flex"
  >
    {
      navItems.map((link) => (
        <a
          class="relative block px-2 py-2 transition hover:text-blue-700 dark:hover:text-blue-400"
          href={link.url}
          data-nav-section={link.label}
        >
          {link.title}
        </a>
      ))
    }
  </nav>
  <div class="flex items-center gap-1">
    <ThemeToggle />
    <button
      id="mobile-menu-toggle"
      type="button"
      class="inline-flex size-10 items-center justify-center rounded-full text-gray-800 hover:bg-gray-200/70 dark:text-white dark:hover:bg-white/10 md:hidden"
      aria-expanded="false"
      aria-controls="mobile-navigation"
    >
      <span class="sr-only">Open navigation</span>
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        class="size-5"
        aria-hidden="true"
      >
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>
  </div>

  <nav
    id="mobile-navigation"
    aria-label="Mobile"
    class="absolute left-0 right-0 top-[calc(100%+.5rem)] z-40 hidden rounded-xl border border-gray-200 bg-white p-2 text-sm font-medium text-gray-800 dark:border-white/10 dark:bg-gray-900 dark:text-gray-100 md:hidden"
  >
    {
      navItems.map((link) => (
        <a
          class="block rounded-lg px-4 py-3 hover:bg-gray-100 dark:hover:bg-white/10"
          href={link.url}
          data-mobile-nav-section={link.label}
        >
          {link.title}
        </a>
      ))
    }
  </nav>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    const sections = document.querySelectorAll("main section[id]");
    const navItems = document.querySelectorAll("header nav a[data-nav-section]");
    const mobileMenu = document.getElementById("mobile-navigation");
    const mobileToggle = document.getElementById("mobile-menu-toggle");

    const setMobileMenuOpen = (open: boolean) => {
      mobileMenu?.classList.toggle("hidden", !open);
      mobileToggle?.setAttribute("aria-expanded", open ? "true" : "false");
    };

    mobileToggle?.addEventListener("click", () => {
      setMobileMenuOpen(mobileToggle.getAttribute("aria-expanded") !== "true");
    });

    mobileMenu?.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setMobileMenuOpen(false));
    });

    const callback = (entries: IntersectionObserverEntry[]) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navItems.forEach((item) => {
            const isActive =
              item.getAttribute("data-nav-section") === entry.target.id;
            item.classList.toggle("text-blue-700", isActive);
            item.classList.toggle("dark:text-blue-400", isActive);
            item.classList.toggle("font-semibold", isActive);
            item.classList.toggle("underline", isActive);
            item.classList.toggle("underline-offset-4", isActive);
            if (isActive) {
              item.setAttribute("aria-current", "location");
            } else {
              item.removeAttribute("aria-current");
            }
          });
        }
      });
    };

    const observer = new IntersectionObserver(callback, {
      root: null,
      rootMargin: "0px",
      threshold: 0.3,
    });

    sections.forEach((section) => {
      observer.observe(section);
    });

    document.onvisibilitychange = () => {
      if (document.visibilityState === "hidden") {
        observer.disconnect();
      } else {
        sections.forEach((section) => {
          observer.observe(section);
        });
      }
    };
  });
</script>

<style>
  .app__navbar {
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    background: hsla(0, 0%, 22%, 0.1);
    border: 1px solid hsla(0, 0%, 41%, 0.3);
    border-radius: 10px;
    padding: 0.625rem 0.75rem;
  }
</style>
